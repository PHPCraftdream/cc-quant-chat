{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ccqc",
            "args": ["hello"],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "ccqc",
            "args": ["wait"],
            "async": true,
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ccqc",
            "args": ["busy"],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ccqc",
            "args": ["wait"],
            "async": true,
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ]
  }
}
